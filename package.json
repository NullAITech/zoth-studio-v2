{
  "name": "zoth-studio-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "main.cjs",
  "bin": {
    "zoth": "./bin/zoth.js",
    "zoth-studio": "./bin/zoth.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "test:routes": "node scripts/test-routes.mjs",
    "preview": "vite preview",
    "zoth": "node ./bin/zoth.js",
    "up": "node ./bin/zoth.js up",
    "serve": "node server/serve.mjs --port 3000",
    "test:serve": "node scripts/test-serve.mjs",
    "test": "python3 scripts/registry-check.py && node scripts/test-serve.mjs",
    "registry:check": "python3 scripts/registry-check.py"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@huggingface/transformers": "^4.3.0",
    "@mui/icons-material": "^5.15.15",
    "@mui/material": "^5.15.15",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^6.22.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.2.8"
  }
}